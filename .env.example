VOICECLAW_TOKEN=paste-your-openclaw-gateway-token-here
VOICECLAW_GATEWAY_URL=ws://127.0.0.1:18789
VOICECLAW_SESSION_KEY=webchat:voice-desktop
VOICECLAW_STT_MODEL=base
VOICECLAW_STT_LANGUAGE=en
VOICECLAW_STT_DEVICE=cpu
VOICECLAW_STT_COMPUTE_TYPE=int8
# Silence duration in seconds before STT stops recording (default: 1.5)
# VOICECLAW_STT_SILENCE=2.0
PIPER_EXECUTABLE=
PIPER_MODEL_PATH=models/piper/en_US-hfc_female-medium.onnx
PIPER_CONFIG_PATH=models/piper/en_US-hfc_female-medium.onnx.json
