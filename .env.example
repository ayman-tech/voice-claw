VOICECLAW_TOKEN=paste-your-openclaw-gateway-token-here
VOICECLAW_GATEWAY_URL=ws://127.0.0.1:18789
VOICECLAW_SESSION_KEY=webchat:voice-desktop
VOICECLAW_STT_MODEL=base.en
VOICECLAW_STT_DEVICE=cpu
VOICECLAW_STT_COMPUTE_TYPE=int8
VOICECLAW_LOG_LEVEL=DEBUG # set for debug mode
# Silence duration in seconds before STT stops recording (default: 0.8)
# VOICECLAW_STT_SILENCE=1.5
# Wake word ("Hey Donna") via openWakeWord; needs a trained .onnx model at this path
# VOICECLAW_WAKE_WORD=1
# VOICECLAW_WAKE_MODEL=models/wake/hey_donna.onnx
# VOICECLAW_WAKE_SENSITIVITY=0.5
PIPER_EXECUTABLE=
PIPER_MODEL_PATH=models/piper/en_US-hfc_female-medium.onnx
PIPER_CONFIG_PATH=models/piper/en_US-hfc_female-medium.onnx.json
# Log detail: INFO (default) or DEBUG (adds every gateway frame, tracker decisions and transcript/reply text)
# VOICECLAW_LOG_LEVEL=DEBUG
